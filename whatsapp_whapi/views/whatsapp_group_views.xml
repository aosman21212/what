<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_group_tree" model="ir.ui.view">
        <field name="name">whatsapp.group.tree</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="group_id"/>
                <field name="participant_count"/>
                <field name="channel_id"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_group_form" model="ir.ui.view">
        <field name="name">whatsapp.group.form</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" type="object" string="Refresh"/>
                    <button name="action_leave" type="object" string="Leave Group" confirm="Leave this group?"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="group_id"/>
                        <field name="channel_id"/>
                        <field name="description"/>
                        <field name="invite_code"/>
                        <field name="participant_count"/>
                    </group>
                    <field name="participant_ids">
                        <list>
                            <field name="participant_id"/>
                            <field name="is_admin"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">whatsapp.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

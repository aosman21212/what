<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_product_tree" model="ir.ui.view">
        <field name="name">whatsapp.product.tree</field>
        <field name="model">whatsapp.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="price"/>
                <field name="currency"/>
                <field name="channel_id"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_product_form" model="ir.ui.view">
        <field name="name">whatsapp.product.form</field>
        <field name="model">whatsapp.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_product" type="object" string="Send Product"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="channel_id"/>
                        <field name="price"/>
                        <field name="currency"/>
                        <field name="collection_id"/>
                        <field name="description"/>
                        <field name="image_url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">whatsapp.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_collection_tree" model="ir.ui.view">
        <field name="name">whatsapp.collection.tree</field>
        <field name="model">whatsapp.collection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="collection_id"/>
                <field name="channel_id"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_collection" model="ir.actions.act_window">
        <field name="name">Collections</field>
        <field name="res_model">whatsapp.collection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

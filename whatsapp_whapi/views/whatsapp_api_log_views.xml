<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_api_log_tree" model="ir.ui.view">
        <field name="name">whatsapp.api.log.tree</field>
        <field name="model">whatsapp.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="channel_id"/>
                <field name="method"/>
                <field name="path"/>
                <field name="status_code"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_api_log_form" model="ir.ui.view">
        <field name="name">whatsapp.api.log.form</field>
        <field name="model">whatsapp.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="channel_id"/>
                        <field name="method"/>
                        <field name="path"/>
                        <field name="status_code"/>
                        <field name="create_date"/>
                    </group>
                    <group>
                        <field name="request_body" widget="text"/>
                        <field name="response_body" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">whatsapp.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('group_whatsapp_manager'))]"/>
    </record>
</odoo>

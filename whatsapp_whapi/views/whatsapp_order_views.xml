<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_order_tree" model="ir.ui.view">
        <field name="name">whatsapp.order.tree</field>
        <field name="model">whatsapp.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="chat_id"/>
                <field name="channel_id"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_order_form" model="ir.ui.view">
        <field name="name">whatsapp.order.form</field>
        <field name="model">whatsapp.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_items" type="object" string="Fetch Items"/>
                </header>
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="chat_id"/>
                        <field name="channel_id"/>
                    </group>
                    <field name="items_json" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">whatsapp.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

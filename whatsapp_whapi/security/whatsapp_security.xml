<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp User</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">WhatsApp Manager</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_whatsapp_channel_user" model="ir.rule">
        <field name="name">WhatsApp Channel: assigned users</field>
        <field name="model_id" ref="model_whatsapp_channel"/>
        <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <record id="rule_whatsapp_channel_manager" model="ir.rule">
        <field name="name">WhatsApp Channel: manager all</field>
        <field name="model_id" ref="model_whatsapp_channel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
    </record>

    <record id="rule_whatsapp_chat_channel" model="ir.rule">
        <field name="name">WhatsApp Chat: by channel access</field>
        <field name="model_id" ref="model_whatsapp_chat"/>
        <field name="domain_force">['|', ('channel_id.user_ids', '=', False), ('channel_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <record id="rule_whatsapp_message_channel" model="ir.rule">
        <field name="name">WhatsApp Message: by channel access</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="domain_force">['|', ('channel_id.user_ids', '=', False), ('channel_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>
</odoo>
